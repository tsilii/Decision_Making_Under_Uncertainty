section("H. ADP Policy Test")
if not eta_path.exists():
    warn("skipping ADP policy test because eta.npy not found")
elif not trajectories:
    warn("skipping ADP policy test because no MILP trajectory solved")
else:
    from pyomo.environ import ConcreteModel, Var, Objective, NonNegativeReals, Binary, SolverFactory, value as pyo_value, minimize as pyo_minimize

    def _solve_adp_step(t, T_r1, T_r2, H, price, occ1, occ2, vent_counter, low_r1, low_r2, eta_weights):
        P_max     = float(params['heating_max_power'])
        P_vent    = float(params['ventilation_power'])
        zeta_exch = float(params['heat_exchange_coeff'])
        zeta_loss = float(params['thermal_loss_coeff'])
        zeta_conv = float(params['heating_efficiency_coeff'])
        zeta_cool = float(params['heat_vent_coeff'])
        zeta_occ  = float(params['heat_occupancy_coeff'])
        eta_occ   = float(params['humidity_occupancy_coeff'])
        eta_vent  = float(params['humidity_vent_coeff'])
        T_out     = list(params['outdoor_temperature'])
        T_low     = float(params['temp_min_comfort_threshold'])
        T_ok      = float(params['temp_OK_threshold'])
        T_high    = float(params['temp_max_comfort_threshold'])
        H_high    = float(params['humidity_threshold'])
        U_vent    = int(params['vent_min_up_time'])

        m    = ConcreteModel()
        m.p1 = Var(domain=NonNegativeReals, bounds=(0, P_max))
        m.p2 = Var(domain=NonNegativeReals, bounds=(0, P_max))
        m.v  = Var(domain=Binary)

        hum_override = H > H_high or (1 <= vent_counter <= U_vent - 1)
        if hum_override:
            m.v.fix(1)

        if T_r1 < T_low:  low_r1 = 1
        if low_r1 == 1 and T_r1 >= T_ok: low_r1 = 0
        if low_r1 == 1 and T_r1 < T_ok:  m.p1.fix(P_max)
        if T_r1 > T_high: m.p1.fix(0)

        if T_r2 < T_low:  low_r2 = 1
        if low_r2 == 1 and T_r2 >= T_ok: low_r2 = 0
        if low_r2 == 1 and T_r2 < T_ok:  m.p2.fix(P_max)
        if T_r2 > T_high: m.p2.fix(0)

        def nT1(m): return T_r1 + zeta_exch*(T_r2-T_r1) - zeta_loss*(T_r1-T_out[t]) + zeta_conv*m.p1 - zeta_cool*m.v + zeta_occ*occ1
        def nT2(m): return T_r2 + zeta_exch*(T_r1-T_r2) - zeta_loss*(T_r2-T_out[t]) + zeta_conv*m.p2 - zeta_cool*m.v + zeta_occ*occ2
        def nH(m):  return H + eta_occ*(occ1+occ2) - eta_vent*m.v

        w = eta_weights[t]
        def obj(m): return price*(m.p1+m.p2+P_vent*m.v) - w[0] - w[1]*nT1(m) - w[2]*nT2(m) - w[3]*nH(m) - w[4]*price - w[5]*occ1 - w[6]*occ2
        m.obj = Objective(rule=obj, sense=pyo_minimize)

        SolverFactory('gurobi').solve(m, tee=False)

        v_val = pyo_value(m.v)
        vent_counter = vent_counter + 1 if v_val == 1 else 0
        return (pyo_value(m.p1), pyo_value(m.p2), v_val,
                low_r1, low_r2, vent_counter,
                pyo_value(nT1(m)), pyo_value(nT2(m)), pyo_value(nH(m)),
                hum_override)

    oos_price_path = ROOT / "OutOfSamplePriceData.csv"
    oos_occ1_path = ROOT / "OutOfSampleOccupancyRoom1.csv"
    oos_occ2_path = ROOT / "OutOfSampleOccupancyRoom2.csv"

    policy_trajectories = []
    if oos_price_path.exists() and oos_occ1_path.exists() and oos_occ2_path.exists():
        oos_price = pd.read_csv(oos_price_path)
        oos_occ1 = pd.read_csv(oos_occ1_path)
        oos_occ2 = pd.read_csv(oos_occ2_path)
        n_policy = min(N_POLICY_TEST, len(oos_price), len(oos_occ1), len(oos_occ2))

        print(f"  Solving out-of-sample MILP benchmarks for {n_policy} policy-test days...")
        for day in range(n_policy):
            prices = oos_price.iloc[day, :].to_numpy(dtype=float)
            occ1 = oos_occ1.iloc[day, :].to_numpy(dtype=float)
            occ2 = oos_occ2.iloc[day, :].to_numpy(dtype=float)
            try:
                policy_trajectories.append(solve_milp_with_results(prices, occ1, occ2, params))
            except Exception as exc:
                warn(f"out-of-sample MILP benchmark day {day + 1} failed: {exc}")
    else:
        warn("out-of-sample data files not found; using the earlier in-sample MILP trajectories for policy smoke test")
        policy_trajectories = trajectories[:min(N_POLICY_TEST, len(trajectories))]

    if not policy_trajectories:
        warn("skipping ADP policy rollout because no benchmark trajectories are available")

    eta_weights = np.load(eta_path)
    adp_costs, milp_costs_g = [], []
    adp_h1_values, adp_h2_values = [], []
    all_actions_valid = True
    all_states_valid  = True
    all_overrule_ok   = True
    all_hum_vent_ok   = True

    for idx, traj in enumerate(policy_trajectories):
        prices_d = np.array(traj['price'])
        occ1_d   = np.array(traj['Occ_r1'])
        occ2_d   = np.array(traj['Occ_r2'])

        T_r1 = float(params['T1'])
        T_r2 = float(params['T2'])
        H    = float(params['H'])
        vc   = int(params['vent_counter'])
        lr1  = int(params['low_override_r1'])
        lr2  = int(params['low_override_r2'])
        P_max  = float(params['heating_max_power'])
        P_vent = float(params['ventilation_power'])
        H_high = float(params['humidity_threshold'])
        U_vent = int(params['vent_min_up_time'])
        T_ok   = float(params['temp_OK_threshold'])

        day_cost = 0.0
        print(f"\n  --- ADP Day {idx+1} ---")
        print(f"  {'hr':>3}  {'price':>7}  {'h_r1':>7}  {'h_r2':>7}  {'v':>3}  {'Hum':>7}  {'lov_r1':>7}  {'lov_r2':>7}  {'T_r1':>7}  {'T_r2':>7}")

        for t in range(t_total):
            price = prices_d[t]
            occ1  = occ1_d[t]
            occ2  = occ2_d[t]
            prev_lr1 = lr1
            prev_lr2 = lr2
            prev_T1 = T_r1
            prev_T2 = T_r2

            h1, h2, v, lr1, lr2, vc, T_r1, T_r2, H, hum_ov = _solve_adp_step(
                t, T_r1, T_r2, H, price, occ1, occ2, vc, lr1, lr2, eta_weights
            )
            day_cost += price * (h1 + h2 + P_vent * v)
            adp_h1_values.append(h1)
            adp_h2_values.append(h2)

            print(f"  {t:3d}  {price:7.4f}  {h1:7.4f}  {h2:7.4f}  {int(round(v)):3d}  {H:7.2f}  {int(lr1):7d}  {int(lr2):7d}  {T_r1:7.2f}  {T_r2:7.2f}")

            if not (-1e-6 <= h1 <= P_max + 1e-6 and -1e-6 <= h2 <= P_max + 1e-6):
                all_actions_valid = False
            if not (np.isclose(v, 0) or np.isclose(v, 1)):
                all_actions_valid = False
            if not (0 <= T_r1 <= 50 and 0 <= T_r2 <= 50):
                all_states_valid = False
            if not (0 <= H <= 100):
                all_states_valid = False
            if hum_ov and not np.isclose(v, 1):
                all_hum_vent_ok = False
            if prev_lr1 == 1 and prev_T1 < T_ok and not np.isclose(h1, P_max, atol=1e-4):
                all_overrule_ok = False
            if prev_lr2 == 1 and prev_T2 < T_ok and not np.isclose(h2, P_max, atol=1e-4):
                all_overrule_ok = False

        adp_costs.append(day_cost)
        milp_cost = trajectory_cost(traj, P_vent)
        milp_costs_g.append(milp_cost)
        gap = day_cost - milp_cost
        gap_pct = 100.0 * gap / milp_cost if abs(milp_cost) > 1e-9 else float('nan')
        print(f"  ADP cost={day_cost:.2f}  MILP cost={milp_cost:.2f}  gap={gap:.2f} ({gap_pct:.1f}%)")

    check("ADP heating actions within [0, P_max]", all_actions_valid)
    check("ADP h_r1 is always 0 or P_max",
          heater_is_bang_bang(adp_h1_values, float(params['heating_max_power'])),
          f"intermediate values: {intermediate_heater_values(adp_h1_values, float(params['heating_max_power']))}")
    check("ADP h_r2 is always 0 or P_max",
          heater_is_bang_bang(adp_h2_values, float(params['heating_max_power'])),
          f"intermediate values: {intermediate_heater_values(adp_h2_values, float(params['heating_max_power']))}")
    check("ADP ventilation is binary", all_actions_valid)
    check("ADP temperatures plausible [0, 50]°C", all_states_valid)
    check("ADP humidity plausible [0, 100]%", all_states_valid)
    check("ADP humidity overrule forces ventilation ON", all_hum_vent_ok)
    check("ADP low-temperature overrule forces heating to P_max", all_overrule_ok)

    avg_adp  = np.mean(adp_costs)
    avg_milp = np.mean(milp_costs_g)
    avg_gap  = avg_adp - avg_milp
    avg_gap_pct = 100.0 * avg_gap / avg_milp if abs(avg_milp) > 1e-9 else float('nan')
    print(f"\n  Avg ADP cost:  {avg_adp:.2f}")
    print(f"  Avg MILP cost: {avg_milp:.2f}")
    print(f"  Avg gap:       {avg_gap:.2f} ({avg_gap_pct:.1f}%)")
    check("ADP-MILP gap is non-negative (ADP >= hindsight)", avg_gap >= -1e-4,
          f"gap={avg_gap:.4f}")
    check("ADP-MILP gap is below 200% (sanity bound)", avg_gap_pct < 200,
          f"gap={avg_gap_pct:.1f}%")



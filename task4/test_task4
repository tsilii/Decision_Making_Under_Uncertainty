def trajectory_cost(traj, p_vent):
    prices = np.array(traj["price"], dtype=float)
    h_r1 = np.array(traj["h_r1"], dtype=float)
    h_r2 = np.array(traj["h_r2"], dtype=float)
    v = np.array(traj["v"], dtype=float)
    return float(np.sum(prices * (h_r1 + h_r2 + p_vent * v)))


def feature_state(T_r1, T_r2, H, price, occ1, occ2):
    return np.array([1.0, T_r1, T_r2, H, price, occ1, occ2], dtype=float)


def build_vfa_training_matrices(trajectories, params):
    """Mirror task4_training_vfa exactly."""
    t_total = int(params["num_timeslots"])
    p_vent = float(params["ventilation_power"])
    n = len(trajectories)
    n_features = 7

    v_star = np.zeros((n, t_total))
    state = np.zeros((t_total, n, n_features))

    for i, traj in enumerate(trajectories):
        prices = np.array(traj["price"], dtype=float)
        h_r1 = np.array(traj["h_r1"], dtype=float)
        h_r2 = np.array(traj["h_r2"], dtype=float)
        v = np.array(traj["v"], dtype=float)
        T_r1 = np.array(traj["Temp_r1"], dtype=float)
        T_r2 = np.array(traj["Temp_r2"], dtype=float)
        H = np.array(traj["Hum"], dtype=float)
        occ1 = np.array(traj["Occ_r1"], dtype=float)
        occ2 = np.array(traj["Occ_r2"], dtype=float)

        cost_per_hour = prices * (h_r1 + h_r2 + p_vent * v)

        for t in range(t_total):
            v_star[i, t] = -np.sum(cost_per_hour[t + 1:])

            if t < t_total - 1:
                state[t, i] = feature_state(
                    T_r1[t + 1], T_r2[t + 1], H[t + 1],
                    prices[t], occ1[t], occ2[t],
                )
            else:
                state[t, i] = feature_state(
                    T_r1[t], T_r2[t], H[t],
                    prices[t], occ1[t], occ2[t],
                )

    return v_star, state


def max_dynamics_error(traj, params):
    t_total = int(params["num_timeslots"])
    zeta_exch = float(params["heat_exchange_coeff"])
    zeta_loss = float(params["thermal_loss_coeff"])
    zeta_conv = float(params["heating_efficiency_coeff"])
    zeta_cool = float(params["heat_vent_coeff"])
    zeta_occ = float(params["heat_occupancy_coeff"])
    eta_occ = float(params["humidity_occupancy_coeff"])
    eta_vent = float(params["humidity_vent_coeff"])
    T_out = list(params["outdoor_temperature"])

    T1 = np.array(traj["Temp_r1"], dtype=float)
    T2 = np.array(traj["Temp_r2"], dtype=float)
    H = np.array(traj["Hum"], dtype=float)
    p1 = np.array(traj["h_r1"], dtype=float)
    p2 = np.array(traj["h_r2"], dtype=float)
    v = np.array(traj["v"], dtype=float)
    occ1 = np.array(traj["Occ_r1"], dtype=float)
    occ2 = np.array(traj["Occ_r2"], dtype=float)

    errors = []
    for t in range(1, t_total):
        pred_T1 = (
            T1[t - 1]
            + zeta_exch * (T2[t - 1] - T1[t - 1])
            - zeta_loss * (T1[t - 1] - T_out[t - 1])
            + zeta_conv * p1[t - 1]
            - zeta_cool * v[t - 1]
            + zeta_occ * occ1[t - 1]
        )
        pred_T2 = (
            T2[t - 1]
            + zeta_exch * (T1[t - 1] - T2[t - 1])
            - zeta_loss * (T2[t - 1] - T_out[t - 1])
            + zeta_conv * p2[t - 1]
            - zeta_cool * v[t - 1]
            + zeta_occ * occ2[t - 1]
        )
        pred_H = H[t - 1] + eta_occ * (occ1[t - 1] + occ2[t - 1]) - eta_vent * v[t - 1]
        errors.extend([abs(T1[t] - pred_T1), abs(T2[t] - pred_T2), abs(H[t] - pred_H)])

    return max(errors) if errors else 0.0


def heater_is_bang_bang(values, p_max, tol=1e-6):
    values = np.array(values, dtype=float)
    return np.all(np.isclose(values, 0.0, atol=tol) | np.isclose(values, p_max, atol=tol))


def intermediate_heater_values(values, p_max, tol=1e-6):
    values = np.array(values, dtype=float).ravel()
    mask = ~(np.isclose(values, 0.0, atol=tol) | np.isclose(values, p_max, atol=tol))
    return np.unique(np.round(values[mask], 6))



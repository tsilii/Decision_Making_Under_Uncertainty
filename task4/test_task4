section("E. OLS Diagnostics")
if trajectories:
    eta = np.zeros((t_total, 7))
    r2_values = []

    for t in range(t_total):
        eta[t], _, _, _ = np.linalg.lstsq(state[t], v_star[:, t], rcond=None)
        pred = state[t] @ eta[t]
        ss_res = np.sum((v_star[:, t] - pred) ** 2)
        ss_tot = np.sum((v_star[:, t] - v_star[:, t].mean()) ** 2)
        r2 = 1 - ss_res / ss_tot if ss_tot > 1e-12 else 1.0
        r2_values.append(r2)

    check("OLS eta is finite", np.all(np.isfinite(eta)))
    check("OLS predictions are finite",
          all(np.all(np.isfinite(state[t] @ eta[t])) for t in range(t_total)))

    print("  R2 by timeslot:")
    for t, r2 in enumerate(r2_values):
        label = "terminal" if t == t_total - 1 else ""
        print(f"    t={t:2d}: {r2:8.4f} {label}")

    if any(r2 < 0 for r2 in r2_values[:-1]):
        warn("some non-terminal R2 values are negative; the linear VFA is weaker than a mean predictor there")
else:
    warn("skipping OLS diagnostics because no MILP trajectory solved")


